# Generated builds and per-device state (including software TPM secrets).
/artifacts/
/build/
/.firearc.lock
# Downloaded archives/packages and generated binaries never belong in Git.
*.deb
*.rpm
*.raw
*.qcow2
*.img
*.ext4
*.verity
*.efi
*.rom
*.iso
*.cpio
*.bin
*.tar
*.tar.*
*.xz
*.gz
*.zip
/run/
/.cache/
/.venv/
__pycache__/
*.py[cod]
.coverage

# Private credentials never belong in this repository. Public .crt/.der/.pem
# certificates are allowed, but must pass `just secrets` before publication.
*.key
*.p12
*.pfx
.env
.env.*
/secrets/
/private/
